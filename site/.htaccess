# =====================================================================
# Danni Som — .htaccess (Hostinger / LiteSpeed ou Apache)
# Vai na raiz do site (public_html), junto com o index.html.
# =====================================================================

Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
AddType font/woff2 .woff2
AddType application/javascript .js
AddType image/webp .webp
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.dannisom.com.br -> https://dannisom.com.br (primeiro: um redirecionamento só, já em https)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # HTTPS (também atrás do Cloudflare, sem entrar em loop)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:CF-Visitor} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html e /index.php (a página antiga "em construção") -> /
  # (só na raiz: o painel/index.php não é afetado)
  RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
  RewriteRule ^index\.(html|php)$ / [L,R=301]

  # endereços sem ".html" também funcionam: /contato -> contato.html
  # (sem barra no fim: em /contato/ os arquivos da página seriam procurados na pasta errada)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>

# Cache: CSS/JS levam ?v=… a cada publicação, então podem ficar 1 ano (o mesmo tipo de arquivo
# pode chegar com nomes diferentes, conforme o servidor: por isso as variações abaixo).
# Páginas: sempre conferir se mudou. Os dados (dados/*.js) têm o próprio .htaccess (o painel grava lá).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Arquivos que nunca devem ser baixados
<FilesMatch "(^\.|\.(md|py|sh|log|bak|sql|ini)$)">
  Require all denied
</FilesMatch>
<FilesMatch "^\.htaccess$">
  Require all denied
</FilesMatch>
